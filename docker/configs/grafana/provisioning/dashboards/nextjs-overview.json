{
	"__inputs": [],
	"__requires": [
		{
			"type": "grafana",
			"id": "grafana",
			"name": "Grafana",
			"version": "10.0.0"
		},
		{
			"type": "datasource",
			"id": "prometheus",
			"name": "Prometheus",
			"version": "1.0.0"
		},
		{ "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
	],
	"annotations": { "list": [] },
	"description": "Next.js app overview — request rate, latency, errors, Stripe, payments",
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 1,
	"id": null,
	"links": [],
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Request Rate (rpm)",
			"gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
			"datasource": { "uid": "prometheus" },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "background",
				"graphMode": "area"
			},
			"targets": [
				{
					"expr": "sum(rate(vlm_http_requests_total[5m])) * 60",
					"legendFormat": "req/min"
				}
			]
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Error Rate",
			"gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
			"datasource": { "uid": "prometheus" },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "background",
				"graphMode": "area"
			},
			"fieldConfig": {
				"defaults": {
					"thresholds": {
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "orange", "value": 0.01 },
							{ "color": "red", "value": 0.05 }
						]
					},
					"unit": "percentunit"
				}
			},
			"targets": [
				{
					"expr": "sum(rate(vlm_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(vlm_http_requests_total[5m]))",
					"legendFormat": "error rate"
				}
			]
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Payments Created (today)",
			"gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
			"datasource": { "uid": "prometheus" },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "background",
				"graphMode": "none"
			},
			"targets": [
				{
					"expr": "increase(vlm_payments_created_total[24h])",
					"legendFormat": "payments"
				}
			]
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Stripe Webhook Errors (1h)",
			"gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
			"datasource": { "uid": "prometheus" },
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "background",
				"graphMode": "none"
			},
			"fieldConfig": {
				"defaults": {
					"thresholds": {
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 1 }
						]
					}
				}
			},
			"targets": [
				{
					"expr": "increase(vlm_stripe_webhook_errors_total[1h])",
					"legendFormat": "webhook errors"
				}
			]
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "HTTP Requests by Route",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
			"datasource": { "uid": "prometheus" },
			"options": { "tooltip": { "mode": "multi" } },
			"targets": [
				{
					"expr": "sum by (route, status) (increase(vlm_http_requests_total[1h]))",
					"legendFormat": "{{route}} {{status}}"
				}
			]
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Request Latency p50 / p95 / p99",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
			"datasource": { "uid": "prometheus" },
			"fieldConfig": { "defaults": { "unit": "s" } },
			"targets": [
				{
					"expr": "histogram_quantile(0.50, sum by (le, route) (rate(vlm_http_request_duration_seconds_bucket[5m])))",
					"legendFormat": "p50 {{route}}"
				},
				{
					"expr": "histogram_quantile(0.95, sum by (le, route) (rate(vlm_http_request_duration_seconds_bucket[5m])))",
					"legendFormat": "p95 {{route}}"
				},
				{
					"expr": "histogram_quantile(0.99, sum by (le, route) (rate(vlm_http_request_duration_seconds_bucket[5m])))",
					"legendFormat": "p99 {{route}}"
				}
			]
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Stripe Webhook Events",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
			"datasource": { "uid": "prometheus" },
			"targets": [
				{
					"expr": "sum by (event_type) (rate(vlm_stripe_webhook_events_total[5m]))",
					"legendFormat": "{{event_type}}"
				}
			]
		},
		{
			"id": 8,
			"type": "logs",
			"title": "Recent App Logs",
			"gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
			"datasource": { "uid": "loki" },
			"options": {
				"dedupStrategy": "none",
				"enableLogDetails": true,
				"prettifyLogMessage": false,
				"showTime": true,
				"showLabels": false,
				"wrapLogMessage": false
			},
			"targets": [
				{
					"expr": "{app=\"volo-libero-montegrappa\"}",
					"legendFormat": ""
				}
			]
		},
		{
			"id": 9,
			"type": "logs",
			"title": "Error Logs Only",
			"gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
			"datasource": { "uid": "loki" },
			"options": {
				"dedupStrategy": "none",
				"enableLogDetails": true,
				"prettifyLogMessage": false,
				"showTime": true,
				"showLabels": false,
				"wrapLogMessage": false
			},
			"targets": [
				{
					"expr": "{app=\"volo-libero-montegrappa\"} | json | level =~ \"error|fatal\"",
					"legendFormat": ""
				}
			]
		}
	],
	"refresh": "30s",
	"schemaVersion": 38,
	"tags": ["nextjs", "vlm"],
	"time": { "from": "now-3h", "to": "now" },
	"timepicker": {},
	"timezone": "browser",
	"title": "VLM — App Overview",
	"uid": "vlm-overview",
	"version": 2
}
