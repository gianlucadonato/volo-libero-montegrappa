generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  MEMBER
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
}

enum XcCategoryLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum XcSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String   @id @default(cuid())
  memberId             Int      @unique @default(autoincrement())
  email                String
  emailVerified        Boolean  @default(false) @map(name: "email_verified")
  name                 String   @default("")
  firstName            String   @map(name: "first_name")
  lastName             String   @map(name: "last_name")
  password             String?
  image                String?
  fiscalCode           String?  @map(name: "fiscal_code")
  dateOfBirth          String?  @map(name: "date_of_birth")
  placeOfBirth         String?  @map(name: "place_of_birth")
  streetAddress        String?  @map(name: "street_address")
  city                 String?
  zipCode              String?  @map(name: "zip_code")
  province             String?
  state                String?
  phone                String?
  gender               String   @default("M")
  size                 String?
  sport                String?
  vdsNumber            String?  @map(name: "vds_number")
  vdsReleaseDate       String?  @map(name: "vds_release_date")
  fivlNumber           String?  @map(name: "fivl_number")
  xcontestId           String?  @map(name: "xcontest_id")
  ognCallsign          String?  @map(name: "ogn_callsign")
  ognHex               String?  @map(name: "ogn_hex")
  medicalExamValidDate String?  @map(name: "medical_exam_valid_date")
  emailConsent         Boolean  @default(true) @map(name: "email_consent")
  isAdmin              Boolean  @default(false) @map(name: "is_admin")
  role                 UserRole @default(USER)

  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime? @map(name: "deleted_at")

  accounts              Account[]
  sessions              Session[]
  memberships           UserMembership[]
  payments              Payment[]           @relation("user")
  paymentsAdded         Payment[]           @relation("creator")
  eventsCreated         Event[]
  newsCreated           News[]
  registrations         EventRegistration[]
  coupons               Coupon[]
  xcEnrollments         XcEnrollment[]
  xcSubmissions         XcTrackSubmission[] @relation("user")
  xcReviewedSubmissions XcTrackSubmission[] @relation("reviewer")
  xcProgresses          XcProgress[]

  @@unique([email])
  @@map(name: "users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserMembership {
  id           Int       @id @default(autoincrement())
  userId       String
  membershipId String
  year         Int
  code         String?
  description  String?
  status       String?
  validFrom    DateTime? @map(name: "valid_from")
  validUntil   DateTime? @map(name: "valid_until")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @map(name: "updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([userId, membershipId])
  @@map(name: "user_membership")
}

model Membership {
  id              String    @id @default(cuid())
  name            String    @unique
  year            Int
  slug            String?
  stripeProductId String?   @map(name: "stripe_product_id")
  stripePriceId   String?   @map(name: "stripe_price_id")
  validFrom       DateTime? @map(name: "valid_from")
  validUntil      DateTime? @map(name: "valid_until")
  createdAt       DateTime  @default(now()) @map(name: "created_at")

  userMembership UserMembership[]

  @@unique([name, year])
  @@map(name: "membership")
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  paymentMethod           String   @map(name: "payment_method")
  amount                  Int
  slug                    String
  description             String?
  product                 String?
  note                    String?
  stripePaymentMethod     String?  @map(name: "stripe_payment_method")
  stripePaymentIntentId   String?  @map(name: "stripe_payment_intent_id")
  stripeCheckoutSessionId String?  @map(name: "stripe_checkout_session_id")
  stripeChargeId          String?  @map(name: "stripe_charge_id")
  stripeReceiptUrl        String?  @map(name: "stripe_receipt_url")
  createdBy               String?  @map(name: "created_by")
  createdAt               DateTime @default(now()) @map(name: "created_at")
  updatedAt               DateTime @default(now()) @map(name: "updated_at")

  user    User  @relation("user", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("creator", fields: [createdBy], references: [id])

  @@index([stripePaymentIntentId], type: Hash)
  @@map(name: "payment")
}

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String
  information     String?
  imageUrl        String?   @map(name: "image_url")
  eventDate       DateTime  @map(name: "event_date")
  optionalDate    DateTime? @map(name: "optional_date")
  startTime       String?   @map(name: "start_time")
  endTime         String?   @map(name: "end_time")
  price           Int?
  location        String?
  locationUrl     String?   @map(name: "location_url")
  maxAvailability Int?      @map(name: "max_availability")
  isMemberOnly    Boolean   @default(false) @map(name: "is_member_only")
  createdBy       String?   @map(name: "created_by")
  createdAt       DateTime  @default(now()) @map(name: "created_at")
  updatedAt       DateTime  @default(now()) @map(name: "updated_at")

  creator       User?               @relation(fields: [createdBy], references: [id])
  registrations EventRegistration[]

  @@map(name: "events")
}

/// A news post, written in the admin editor (BlockNote). `content` is the
/// editor's block JSON, the source of truth; `contentHtml` is rendered from it
/// on save so public pages never need the editor.
model News {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  coverUrl    String?   @map(name: "cover_url")
  content     Json
  contentHtml String    @map(name: "content_html")
  publishedAt DateTime  @map(name: "published_at")
  draft       Boolean   @default(false)
  // Set once the news has been posted to Telegram, so it is posted only once.
  announcedAt DateTime? @map(name: "announced_at")
  createdBy   String?   @map(name: "created_by")
  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")
  deletedAt   DateTime? @map(name: "deleted_at")

  creator User? @relation(fields: [createdBy], references: [id])

  @@index([publishedAt])
  @@map(name: "news")
}

model EventRegistration {
  id        String                  @id @default(cuid())
  userId    String
  eventId   String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime                @default(now()) @map(name: "created_at")
  updatedAt DateTime                @default(now()) @map(name: "updated_at")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map(name: "events_registrations")
}

model Report {
  id                 String    @id @default(cuid())
  folder             String
  s3startTime        DateTime?
  s3endTime          DateTime?
  s3duration         String?
  s3error            String?
  ftpStartTime       DateTime?
  ftpEndTime         DateTime?
  ftpDuration        String?
  ftpError           String?
  totalFiles         Int
  totalUploadedFiles Int
  totalBytes         Int
  totalMegaBytes     String?
  startTime          DateTime
  endTime            DateTime?
  duration           String?
  error              Boolean   @default(false)
  createdAt          DateTime  @default(now()) @map(name: "created_at")
  updatedAt          DateTime  @default(now()) @map(name: "updated_at")

  @@unique([folder])
  @@map(name: "reports")
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  year       Int
  type       String?
  userId     String?
  validFrom  DateTime? @map(name: "valid_from")
  validUntil DateTime? @map(name: "valid_until")
  createdAt  DateTime  @default(now()) @map(name: "created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map(name: "coupon")
}

model XcEdition {
  id          Int      @id // YEAR
  title       String
  description String?
  startsAt    DateTime @map(name: "starts_at")
  endsAt      DateTime @map(name: "ends_at")
  isActive    Boolean  @default(false) @map(name: "is_active")
  minPoints   Int      @default(700) @map(name: "min_points")
  maxPoints   Int      @default(1000) @map(name: "max_points")
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  enrollments  XcEnrollment[]
  submissions  XcTrackSubmission[]
  editionTasks XcEditionTasks[]
  xcProgresses XcProgress[]

  @@index([isActive])
  @@map(name: "xc_editions")
}

model XcTask {
  id          String          @id @default(cuid())
  slug        String
  name        String
  description String?
  points      Int
  category    XcCategoryLevel
  distanceKm  Float?          @map(name: "distance_km")
  taskFileUrl String?         @map(name: "task_file_url")
  imageUrl    String?         @map(name: "image_url")
  createdAt   DateTime        @default(now()) @map(name: "created_at")
  updatedAt   DateTime        @updatedAt @map(name: "updated_at")

  submissions  XcTrackSubmission[]
  editionTasks XcEditionTasks[]

  @@unique([category, slug])
  @@map(name: "xc_tasks")
}

model XcEditionTasks {
  editionId Int      @map(name: "edition_id")
  taskId    String   @map(name: "task_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  task    XcTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  edition XcEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([taskId, editionId])
  @@map(name: "xc_edition_tasks")
}

model XcEnrollment {
  userId    String   @map(name: "user_id")
  editionId Int      @map(name: "edition_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition XcEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@map(name: "xc_enrollments")
}

model XcTrackSubmission {
  id               String             @id @default(cuid())
  userId           String             @map(name: "user_id")
  editionId        Int                @map(name: "edition_id")
  taskId           String             @map(name: "task_id")
  status           XcSubmissionStatus @default(PENDING)
  fileName         String             @map(name: "file_name")
  checksum         String?
  notes            String?
  pointsAwarded    Int                @default(0) @map(name: "points_awarded")
  validationResult Json?              @map(name: "validation_result")
  flightData       Json?              @map(name: "flight_data")
  reviewedAt       DateTime?          @map(name: "reviewed_at")
  reviewedBy       String?            @map(name: "reviewed_by")
  createdAt        DateTime           @default(now()) @map(name: "created_at")
  updatedAt        DateTime           @updatedAt @map(name: "updated_at")

  user     User      @relation("user", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?     @relation("reviewer", fields: [reviewedBy], references: [id])
  edition  XcEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  task     XcTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, editionId])
  @@index([taskId, status])
  @@index([status])
  @@map(name: "xc_track_submissions")
}

model XcProgress {
  id              String          @id @default(cuid())
  userId          String          @map(name: "user_id")
  editionId       Int             @map(name: "edition_id")
  category        XcCategoryLevel
  points          Int             @default(0)
  minPoints       Int             @map(name: "min_points")
  totalDistanceKm Float           @default(0) @map(name: "total_distance_km")
  flightTimeHrs   Float           @default(0) @map(name: "flight_time_hrs")
  maxAltM         Float           @default(0) @map(name: "max_alt_m")
  completedAt     DateTime?       @map(name: "completed_at")
  createdAt       DateTime        @default(now()) @map(name: "created_at")
  updatedAt       DateTime        @updatedAt @map(name: "updated_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition XcEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId, category])
  @@index([userId, editionId, category])
  @@map(name: "xc_progress")
}

/// One hourly row of an elmeteo.it take-off forecast.
///
/// Keyed by (site, day, hour) so a re-run of the same day overwrites its rows
/// in place: the source republishes a corrected forecast about four times a
/// day, and only the latest reading for an hour is of interest.
model ElmeteoForecast {
  id                    String    @id @default(cuid())
  /// Site slug from lib/elmeteo-sites.ts, e.g. "tappeti".
  site                  String
  /// Forecast day as YYYY-MM-DD in Europe/Rome, the source's own timezone.
  day                   String
  /// Hour the row is valid until, 0-23.
  hour                  Int
  cloudsHigh            Int?
  cloudsMedium          Int?
  cloudsLow             Int?
  /// The source's own weather glyph, as the bare filename it publishes it
  /// under, e.g. "sereno" / "parznuv" / "nebbia". Stored verbatim: the
  /// vocabulary is open, so an unseen name is kept and mapped at render.
  weatherIcon           String?
  /// "low" | "medium" | "high", from the icon the source grades the hour with.
  riskLevel             String?
  risk                  String?
  temperatureC          Float?
  precipitationMm       Float?
  maxFlightAltitude     String?
  maxFlightMinM         Int?
  maxFlightMaxM         Int?
  cloudBaseMinM         Int?
  cloudBaseMaxM         Int?
  /// The source printed "MIN same altitude or lower": no lower bound exists.
  cloudBaseBelowTakeOff Boolean   @default(false)
  /// Updraft ceilings in metres, highest first; empty when no thermal activity.
  thermalUpdraftsM      Int[]
  /// The subset reachable from take-off — the source prints those in green,
  /// and the ones above the inversion in red. A pilot can only climb to these.
  reachableUpdraftsM    Int[]
  /// Inversion bands as [{ fromM, toM }], in source order. JSON because an
  /// hour can carry two of them and Prisma has no array-of-pairs scalar.
  stableLayers          Json      @default("[]")
  /// Wind readings per altitude, as [{ label, direction, speedKmh, gustKmh }].
  /// Stored as JSON because the set of altitude columns differs per site.
  winds                 Json
  /// Take-off altitude printed on the page, in metres.
  altitudeM             Int?
  /// "Maximum Daily Cloud Base Altitude" for the day.
  maxDailyCloudBaseM    Int?
  /// When the source last refreshed its model, as printed on the page.
  sourceUpdatedAt       DateTime?
  /// When this row was last written by the scraper.
  scrapedAt             DateTime  @default(now())
  createdAt             DateTime  @default(now()) @map(name: "created_at")
  updatedAt             DateTime  @updatedAt @map(name: "updated_at")

  @@unique([site, day, hour])
  @@index([site, day])
  @@map(name: "elmeteo_forecasts")
}
