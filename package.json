{
	"name": "volo-libero-montegrappa",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"homepage": "https://github.com/gianlucadonato/volo-libero-montegrappa",
	"scripts": {
		"dev": "next dev --webpack",
		"dev:turbo": "next dev --turbopack",
		"build": "next build",
		"test": "vitest run",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev --name",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:execute": "prisma db execute --file",
		"db:seed:xc-tasks": "pnpm tsx scripts/seedXcTasks.ts",
		"db:seed:xc-progress": "pnpm tsx scripts/seedXcProgress.ts",
		"db:sync": "pnpm tsx scripts/db-sync.ts",
		"prod": "pnpm tsx scripts/prod.ts",
		"infra:up": "docker compose -f docker/docker-compose.postgres.yml up -d",
		"infra:down": "docker compose -f docker/docker-compose.postgres.yml down",
		"tsx": "tsx --env-file=.env",
		"openapi": "openapi-gen generate",
		"gen:api-client": "pnpm openapi && openapi-typescript ./public/openapi.json -o ./types/api-client.d.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
