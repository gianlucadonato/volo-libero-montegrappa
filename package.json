{
	"name": "volo-libero-montegrappa",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/gianlucadonato/volo-libero-montegrappa",
	"scripts": {
		"dev": "next dev --webpack",
		"dev:turbo": "next dev --turbopack",
		"build": "next build",
		"test": "echo 'No tests! :(' && exit 0",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate --sql",
		"db:migrate": "prisma migrate dev --name",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "pnpm tsx scripts/seedXcTasks.ts",
		"tsx": "tsx --env-file=.env",
		"openapi": "openapi-gen generate",
		"generate:api-client": "openapi-typescript http://localhost:3000/openapi.json -o ./types/api-client.d.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
