# Build context exclusions for Railpack/Docker deploys (Dokploy).
# Keep this in sync with .gitignore where it makes sense, but note the goals
# differ: .gitignore keeps junk out of history, this keeps weight out of the
# image. Anything the app serves at runtime (public/, content/, messages/,
# prisma/, scripts/) must stay.
#
# NOTE: do not use negation patterns (!foo) here. Railpack 0.15.x predates the
# BuildKit lstat fixes for negations and they can fail the build.

# Version control — by far the biggest win (~350 MB packed).
# Safe to drop: the "prepare" script (husky) no-ops when .git is absent.
.git
.gitignore
.gitattributes
.github

# Dependencies — reinstalled from the lockfile during the install step.
node_modules
.pnp
.pnp.*
.yarn
.pnpm-store

# Build artifacts — regenerated by `next build`.
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Secrets — Dokploy injects env vars at build/run time, so these must never
# be baked into an image layer.
.env
.env.*
*.pem

# Tests and coverage — not used at runtime.
tests
coverage
vitest.config.ts

# Local infrastructure — compose files for the dev Postgres/observability stack.
docker

# Editor, OS and agent tooling.
.idea
.vscode
.claude
.agents
.husky
.DS_Store
**/.DS_Store

# Logs and debug output.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docs and local-only config.
README.md
CLAUDE.md
.editorconfig
.openapi-gen
.vercel
